<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura de las pruebas unitarias: Domain, Application y Api.
  Infrastructure (EF Core, PostgreSQL, Kafka) se mide con las pruebas de integración (Testcontainers),
  que el CI ejecuta en cada push y combina en el mismo reporte.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Include>[QuickPatch.ServiceRequest.Domain]*,[QuickPatch.ServiceRequest.Application]*,[QuickPatch.ServiceRequest.Api]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
